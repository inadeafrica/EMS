# OpenEMS Environment Configuration
# Copy this file to .env and update with your values

# Timezone
TZ=UTC

# Database Configuration
POSTGRES_DB=openems
POSTGRES_USER=openems
POSTGRES_PASSWORD=openems

# InfluxDB Configuration
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=adminpassword
INFLUXDB_ORG=openems
INFLUXDB_BUCKET=energy_data
INFLUXDB_TOKEN=openems-token-change-in-production

# OpenEMS Edge Configuration
EDGE_API_PORT=8085

# OpenEMS Backend Configuration
BACKEND_API_PORT=8084

# OpenEMS UI Configuration
UI_PORT=8080
